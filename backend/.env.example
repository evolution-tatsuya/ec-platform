# Server Configuration
PORT=8432
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3247

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# Session Secret (generate a random string, 32+ characters)
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-bucket.r2.dev

# Stripe Payment
STRIPE_PUBLIC_KEY=pk_test_your-test-public-key
STRIPE_SECRET_KEY=sk_test_your-test-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Email Service (Resend)
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# AI Services
OPENAI_API_KEY=sk-your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# 在庫管理アプリ 発行API連携（P2）
# INVENTORY_API_KEY は在庫側から安全な経路で受け取り、ここには値を書かない（gitコミット禁止）
INVENTORY_API_KEY=
# 省略時は本番既定URLを使用（inventoryProvisionService.ts）
INVENTORY_API_BASE_URL=https://inventory-backend-72579044624.asia-northeast1.run.app

# GPSラップタイマー 発行API連携（在庫とは別物・鍵の使い回し禁止）
# GPS_API_KEY は GPS側から安全な経路で受け取り、ここには値を書かない（gitコミット禁止）
# ※ INVENTORY_API_KEY とは必ず別の値（パスワードマネージャー: GPS-EC-Integration-Key）
GPS_API_KEY=
# 省略時は本番既定URLを使用（gpsProvisionService.ts）
GPS_API_BASE_URL=https://gps-lap-timer-563027052499.asia-northeast1.run.app
