# 本番環境 環境変数テンプレート
# このファイルをコピーして .env.production を作成し、実際の値を設定してください
# ⚠️ .env.production は .gitignore に含まれているため、Gitにコミットされません

# ============================================
# 必須環境変数（バックエンド）
# ============================================

# 実行環境
NODE_ENV=production

# データベース（Neon PostgreSQL）
# 形式: postgresql://[user]:[password]@[host]/[database]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# セッション管理
# 生成方法: openssl rand -base64 32
SESSION_SECRET=REPLACE_WITH_RANDOM_32_BYTE_STRING

# CORS設定
# Vercelデプロイ後のフロントエンドURLを設定
CORS_ORIGIN=https://your-app.vercel.app

# サーバーポート
PORT=8432

# ============================================
# 必須環境変数（フロントエンド）
# ============================================

# バックエンドAPI URL
# Cloud RunデプロイGoogle 後のURLを設定
VITE_API_URL=https://ec-platform-backend-xxxxxxxxx-an.a.run.app

# ============================================
# オプション環境変数（使用する機能に応じて設定）
# ============================================

# --- ストレージ（Cloudflare R2） ---
# 画像アップロード機能を使用する場合に必要
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=ec-platform-production

# --- 決済（Stripe） ---
# 決済機能を使用する場合に必要
# ⚠️ 本番モード（sk_live_、pk_live_）を使用
STRIPE_PUBLIC_KEY=<YOUR_STRIPE_PUBLISHABLE_KEY>
STRIPE_SECRET_KEY=<YOUR_STRIPE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<YOUR_STRIPE_WEBHOOK_SECRET>

# フロントエンド（Vercel環境変数に設定）
VITE_STRIPE_PUBLIC_KEY=<YOUR_STRIPE_PUBLISHABLE_KEY>

# --- メール送信（Resend） ---
# メール送信機能を使用する場合に必要
RESEND_API_KEY=<YOUR_RESEND_API_KEY>
RESEND_FROM_EMAIL=noreply@yourdomain.com

# --- AI機能（OpenAI） ---
# AI自動返答機能を使用する場合に必要
# ⚠️ 使用量制限を設定することを強く推奨
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- AI機能（Google Gemini） ---
# Gemini AI機能を使用する場合に必要
GEMINI_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ============================================
# セキュリティ設定のチェックリスト
# ============================================

# ✅ SESSION_SECRETは32バイト以上のランダム文字列
# ✅ DATABASE_URLは本番用（開発環境と別）
# ✅ Stripe APIキーは本番モード（sk_live_、pk_live_）
# ✅ CORS_ORIGINは本番フロントエンドURLのみ
# ✅ OpenAI APIキーに使用量制限を設定済み
# ✅ このファイル（.env.production）は.gitignoreに含まれている

# ============================================
# デプロイ先別の設定方法
# ============================================

# --- Google Cloud Run ---
# 方法1: gcloud コマンドで設定
# gcloud run services update ec-platform-backend \
#   --region asia-northeast1 \
#   --set-env-vars "NODE_ENV=production,DATABASE_URL=...,..."

# 方法2: Cloud Run コンソールで設定
# 1. Cloud Run サービス一覧から対象サービスを選択
# 2. 「編集とデプロイ」をクリック
# 3. 「変数とシークレット」タブで環境変数を追加

# --- Vercel ---
# 方法1: Vercel ダッシュボードで設定
# 1. https://vercel.com/dashboard でプロジェクトを選択
# 2. Settings → Environment Variables
# 3. 環境（Production、Preview、Development）ごとに設定

# 方法2: vercel コマンドで設定
# vercel env add VITE_API_URL production
# vercel env add VITE_STRIPE_PUBLIC_KEY production

# ============================================
# 環境変数の優先順位
# ============================================

# 1. システム環境変数（export で設定）
# 2. .env.production（本番環境用）
# 3. .env.local（ローカル開発用）
# 4. .env（デフォルト値）

# ============================================
# トラブルシューティング
# ============================================

# 問題: 環境変数が反映されない
# 解決: サービスを再起動、またはデプロイを再実行

# 問題: DATABASE_URL接続エラー
# 解決: Neonコンソールで接続文字列を再確認、Pooled connectionを使用

# 問題: CORSエラー
# 解決: CORS_ORIGINがフロントエンドの本番URLと一致しているか確認
